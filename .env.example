# Copy to .env and fill in. docker-compose reads it (`env_file: .env`), so the
# container gets everything here.
#
# Nothing in this file is optional unless it says so: the app will not boot
# without the four Shopify values, and @shopify/shopify-app-express reads them
# straight from the environment rather than from any config file in the repo.

# ── Shopify app credentials ──────────────────────────────────────────────────
# Partner Dashboard → your app → API credentials.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Must match [access_scopes] in shopify.app.toml. Shopify grants what the TOML
# declares; this variable is what the library compares against, so the two
# drifting apart is invisible until something behaves oddly. Update both, and
# run `shopify app deploy` for the TOML side to reach Shopify.
SCOPES=read_orders,write_assigned_fulfillment_orders,write_merchant_managed_fulfillment_orders,write_third_party_fulfillment_orders

# The app's public URL, matching application_url in shopify.app.toml.
# No trailing slash.
HOST=https://fulfill.epicnexusgroup.com

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8081

# ── Optional ─────────────────────────────────────────────────────────────────
# The `handle` from shopify.app.toml. Only the managed pricing URL uses it, and
# it falls back to the value in config/index.js.
# SHOPIFY_APP_HANDLE=epic-fulfill-bulk-orders

# Development stores can only hold *test* subscriptions, so a container being
# tested against one needs this. It MUST be false or unset for real merchants:
# true means a test charge unlocks the app for a shop that has never paid.
# BILLING_ACCEPT_TEST_CHARGES=false

# Both default to the mounted volume in production, which is the only path in
# the container that survives an image update. Override only if the volume moves.
# SESSION_DB_PATH=/app/data/database.sqlite
# REPORT_DIR=/app/data/reports

# Takes precedence over PORT. The healthcheck reads it too.
# BACKEND_PORT=8081
